      } catch (err) {
        // Render empty or retry
        document.getElementById('resultsTableBody').innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted); padding:3rem;">No submissions yet.</td></tr>';
      }
    }

    function renderResultsTable(attempts) {
      const tbody = document.getElementById('resultsTableBody');
      tbody.innerHTML = '';

      if (!attempts || attempts.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted); padding:3rem;">No submissions yet.</td></tr>';
        return;
      }

      attempts.forEach(a => {
        const studentName = a.user ? `${a.user.firstName} ${a.user.lastName}` : 'Student';
        const quizTitle = a.quiz ? a.quiz.title : 'Quiz';
        const score = `${a.percentage}%`;
        const status = a.passed ? '<span class="status-badge status-published">PASSED</span>' : '<span class="status-badge status-draft">FAILED</span>';
        const time = a.timeTaken ? `${Math.floor(a.timeTaken / 60)}m ${a.timeTaken % 60}s` : 'N/A';
        
        const date = new Date(a.completedAt).toLocaleDateString(undefined, {
          month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
        });

        tbody.innerHTML += `
          <tr>
            <td style="font-weight:600; color:white;">${studentName}</td>
            <td>${quizTitle}</td>
            <td style="font-weight:700; color:white;">${score}</td>
            <td>${status}</td>
            <td>${time}</td>
            <td>${date}</td>
            <td>
              ${a.aiInsights && a.aiInsights.performanceSummary 
                ? `<button class="btn-action" onclick="showAiInsightModal('${escapeHtml(a.aiInsights.performanceSummary)}', '${escapeHtml((a.aiInsights.strengths || []).join(','))}', '${escapeHtml((a.aiInsights.weaknesses || []).join(','))}')">View AI Insight</button>`
                : '<span style="color:var(--text-muted); font-size:13px;">No insight</span>'
              }
            </td>
          </tr>
        `;
      });
    }

    function showAiInsightModal(summary, strengths, weaknesses) {
      document.getElementById('insightSummaryText').textContent = summary || 'No summary available.';
      
      const sContainer = document.getElementById('insightStrengths');
      const wContainer = document.getElementById('insightWeaknesses');

      sContainer.innerHTML = '';
      wContainer.innerHTML = '';

      const sArr = strengths ? strengths.split(',') : [];
      const wArr = weaknesses ? weaknesses.split(',') : [];

      if (sArr.length > 0 && sArr[0] !== '') {
        sArr.forEach(s => sContainer.innerHTML += `<span class="tag strength">${s}</span>`);
      } else {
        sContainer.innerHTML = '<span class="tag neutral">None identified yet</span>';
      }

      if (wArr.length > 0 && wArr[0] !== '') {
        wArr.forEach(w => wContainer.innerHTML += `<span class="tag weakness">${w}</span>`);
      } else {
        wContainer.innerHTML = '<span class="tag neutral">No focus areas identified</span>';
      }

      document.getElementById('insightModal').style.display = 'flex';
      feather.replace();
    }

    function closeInsightModal() {
      document.getElementById('insightModal').style.display = 'none';
    }

    // Utils
    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
  </script>
