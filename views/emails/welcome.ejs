<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Welcome to QuizMinia</title>
</head>
<body style="font-family: sans-serif; background-color: #090d16; color: #e2e8f0; margin: 0; padding: 20px;">
  <div style="max-width: 560px; margin: 0 auto; padding: 32px; background-color: #0f172a; border-radius: 12px; border: 1px solid #1e293b; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
    <h2 style="color: #818cf8; margin-top: 0; font-size: 24px; font-weight: 700; border-bottom: 1px solid #1e293b; padding-bottom: 12px;">🎉 Welcome to QuizMinia!</h2>
    <p style="font-size: 16px; line-height: 1.5; color: #94a3b8;">Hi <strong><%= name %></strong>,</p>
    <p style="font-size: 16px; line-height: 1.5; color: #cbd5e1;">
      Your <strong style="color: #c4b5fd; text-transform: capitalize;"><%= role %></strong> account is ready. 
      <% if (role === 'teacher') { %>
        Start creating adaptive quizzes for your students!
      <% } else { %>
        Start taking AI-adaptive quizzes and track your progress!
      <% } %>
    </p>
    <div style="margin-top: 28px; text-align: center;">
      <a href="<%= appDomain %>/dashboard" 
         style="display: inline-block; padding: 12px 28px; background-color: #6366f1; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; transition: background-color 0.2s;">
        Get Started →
      </a>
    </div>
    <p style="margin-top: 32px; font-size: 12px; color: #64748b; text-align: center; border-top: 1px solid #1e293b; padding-top: 16px;">
      QuizMinia · AI-Adaptive Learning Platform
    </p>
  </div>
</body>
</html>
