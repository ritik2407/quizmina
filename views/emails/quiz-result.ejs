<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Quiz Result</title>
</head>
<body style="font-family: sans-serif; background-color: #090d16; color: #e2e8f0; margin: 0; padding: 20px;">
  <div style="max-width: 560px; margin: 0 auto; padding: 32px; background-color: #0f172a; border-radius: 12px; border: 1px solid #1e293b; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
    <h2 style="color: #818cf8; margin-top: 0; font-size: 24px; font-weight: 700; border-bottom: 1px solid #1e293b; padding-bottom: 12px;">📊 Quiz Result</h2>
    <p style="font-size: 16px; line-height: 1.5; color: #94a3b8;">Hi <strong><%= name %></strong>,</p>
    <p style="font-size: 16px; line-height: 1.5; color: #cbd5e1;">You completed <strong style="color: #c4b5fd;">"<%= quizTitle %>"</strong>.</p>
    
    <div style="text-align: center; padding: 24px; background: rgba(99, 102, 241, 0.08); border-radius: 12px; margin: 20px 0; border: 1px solid rgba(99, 102, 241, 0.2);">
      <div style="font-size: 48px; font-weight: 800; color: <%= passed ? '#22c55e' : '#ef4444' %>;"><%= percentage.toFixed(1) %>%</div>
      <div style="font-size: 18px; color: <%= passed ? '#22c55e' : '#ef4444' %>; font-weight: 600; margin-top: 4px;">
        <%= passed ? 'PASSED 🎉' : 'NOT PASSED — Keep Going!' %>
      </div>
    </div>

    <% if (summary) { %>
      <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 8px; font-size: 14px; line-height: 1.5; color: #e2e8f0; border-left: 4px solid #818cf8; margin-bottom: 20px;">
        <strong>🤖 AI Insight:</strong> <%= summary %>
      </div>
    <% } %>

    <div style="text-align: center; margin-top: 24px;">
      <a href="<%= appDomain %>/dashboard"
         style="display: inline-block; padding: 12px 28px; background-color: #6366f1; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600;">
        View Full Results →
      </a>
    </div>
    <p style="margin-top: 32px; font-size: 12px; color: #64748b; text-align: center; border-top: 1px solid #1e293b; padding-top: 16px;">
      QuizMinia · AI-Adaptive Learning Platform
    </p>
  </div>
</body>
</html>
